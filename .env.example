# Ninguna de estas variables es obligatoria para que el sitio compile, pero
# CADA notificador que quede sin configurar se salta en silencio: el formulario
# responde "éxito" y el lead se pierde. Como mínimo configura Resend o Telegram.

# === Email (Resend) ===
# 1. Crea una cuenta en https://resend.com
# 2. API Keys > Create API Key (permiso "Sending access")
RESEND_API_KEY=re_xxxxxxxxxxxx
# 3. Domains > Add Domain > vantrust.com.co y agrega los registros DNS (SPF/DKIM).
#    Sin dominio verificado solo puedes usar onboarding@resend.dev, que únicamente
#    entrega al correo dueño de la cuenta: el correo de confirmación al CLIENTE
#    fallaría en todos los casos reales.
RESEND_FROM_EMAIL="VanTrust <no-responder@vantrust.com.co>"

# Correo del asesor que recibe los leads (por defecto: coordinador@vantrust.com.co)
COMMERCIAL_EMAIL=coordinador@vantrust.com.co

# === Telegram (aviso instantáneo al equipo comercial) ===
# 1. Escríbele a @BotFather en Telegram > /newbot > nombre y usuario del bot.
#    Te devuelve el token con el formato 8123456789:AAH....
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2. Crea un grupo con los asesores, agrega el bot y escribe cualquier mensaje.
# 3. Saca el chat id con:
#    curl "https://api.telegram.org/bot<TU_TOKEN>/getUpdates" | grep -o '"chat":{"id":[-0-9]*'
#    Grupo = número negativo (ej. -1001234567890). Chat personal = positivo.
TELEGRAM_CHAT_ID=-1001234567890

# === Supabase (base de datos de leads) ===
# 1. Crea el proyecto en https://supabase.com (región São Paulo o us-east).
# 2. SQL Editor > pega supabase/migrations/20261108000000_leads.sql > Run.
# 3. Project Settings > API: copia la URL y la clave "service_role" (secreta:
#    solo va en el servidor, nunca en una variable NEXT_PUBLIC_).
# Sin estas variables el lead igual llega por Telegram y correo, pero no se guarda.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# === Google Sheets (CRM básico, OBSOLETO) ===
# Ojo: la API de Sheets no permite ESCRIBIR con una API key (solo leer), así que
# este canal no guarda nada. Se reemplaza por Supabase; se puede quitar.
# 1. Crea un Google Sheet con una pestaña llamada "Leads"
# 2. Compártela como "cualquiera con el enlace puede editar"
# 3. Copia el ID de la URL (entre /d/ y /edit)
GOOGLE_SHEET_ID=tu_sheet_id_aqui
# 4. Obtén una API key en https://console.cloud.google.com (habilita Google Sheets API)
GOOGLE_SHEETS_API_KEY=tu_api_key_aqui

# === WhatsApp Business API (opcional) ===
# Configura en https://developers.facebook.com > WhatsApp
WHATSAPP_PHONE_ID=tu_phone_id
WHATSAPP_TOKEN=tu_token
WHATSAPP_COMMERCIAL_PHONE=57300000000

# === Medición (opcional: sin el ID, ese script simplemente no se carga) ===
# Meta Pixel: Events Manager > Orígenes de datos > tu pixel > ID (solo números)
NEXT_PUBLIC_META_PIXEL_ID=
# GA4: Administrar > Flujos de datos > Web > ID de medición (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Conversions API (servidor): Events Manager > tu pixel > Configuración >
# "Generar token de acceso". Secreto: sin NEXT_PUBLIC_.
META_CAPI_TOKEN=
# Opcional, solo para probar: código de "Probar eventos" en Events Manager.
# Quítalo en producción o los eventos quedan marcados como de prueba.
META_TEST_EVENT_CODE=
# Vercel Analytics no necesita variable: actívalo en el proyecto (pestaña Analytics).

# === Registro como intermediario de seguros ===
# Se muestra en el footer solo si está definido (no publicar un número inventado).
NEXT_PUBLIC_REGISTRO_INTERMEDIARIO=

# === Asesor de la respuesta automática (correo de confirmación al cliente) ===
# Sin ASESOR_NOMBRE el correo sale genérico ("un asesor"). Nada inventado.
ASESOR_NOMBRE=
ASESOR_CARGO=Asesor de seguros
# Foto cuadrada (mín. 120x120). Súbela a /public (ej. /asesor.jpg) o usa una URL.
# Los correos necesitan URL pública: depende de SITE_URL.
ASESOR_FOTO=
# WhatsApp directo del asesor (opcional). Si falta, se usa el del sitio.
ASESOR_WHATSAPP=
# URL pública del sitio para imágenes de correo (logo y foto del asesor).
SITE_URL=https://vantrust.vercel.app

# === Cron de renovaciones (vercel.json, diario 8:00 a. m. Colombia) ===
# Vercel lo manda en el header Authorization al llamar al cron. Pon un valor
# largo y aleatorio en el proyecto (ej. `openssl rand -hex 32`).
CRON_SECRET=
